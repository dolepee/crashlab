    "crashlab_runner.js": "1ea6b8fdf776987478a8a24877f0f104d7dbdcd1afa55816ec52884d4be0ad31",
    "crashlab_probe.py": "8d1005f184cf446722f4527d067783696556f558a560b103944274b03bcdf050",
    "repair_workflow.py": "67c095b1e54f6a246a10781928abd6b45c8de3c2697e82eb785c232f29210e24"
  },
  "binding_fields": [
    "project_path",

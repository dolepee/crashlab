{
  "id": "kist-one-intent",
  "app": {
    "start": {
      "command": [
        "{PYTHON}",
        "server/app.py"
      ],
      "cwd": "{APP_DIR}",
      "env": {
        "FINANCE_PROJECT_DIR": "{DATA_DIR}"
      },
      "base_url": "http://127.0.0.1:{PORT}",
      "health_path": "/",
      "ready_timeout": 30,
      "setup": [
        {
          "method": "POST",
          "path": "/api/app-config",
          "json": {
            "modules": {},
            "wizard_completed": true,
            "base_currency": "USD"
          }
        }
      ]
    }
  },
  "journey": [
    {
      "action": "goto",
      "path": "/#goals"
    },
    {
      "action": "wait_for_selector",
      "selector": "#gAdd"
    },
    {
      "action": "fill",
      "selector": "#gName",
      "value": "CRASHLAB_KIST_ONE_INTENT"
    },
    {
      "action": "fill",
      "selector": "#gTarget",
      "value": "1000"
    },
    {
      "action": "fill",
      "selector": "#gCurrent",
      "value": "100"
    },
    {
      "action": "fill",
      "selector": "#gMonthly",
      "value": "50"
    },
    {
      "action": "click",
      "selector": "#gAdd"
    },
    {
      "action": "wait_for_fault"
    },
    {
      "action": "screenshot",
      "as": "lost-response"
    },
    {
      "action": "click",
      "selector": "#gAdd"
    },
    {
      "action": "wait_for_any",
      "conditions": [
        {
          "kind": "count",
          "selector": "#gList h3",
          "text": "CRASHLAB_KIST_ONE_INTENT",
          "min": 2
        },
        {
          "kind": "value",
          "selector": "#gName",
          "empty": true
        }
      ]
    },
    {
      "action": "screenshot",
      "as": "after-retry"
    }
  ],
  "fault": {
    "route": "**/api/goals",
    "method": "POST",
    "mode": "suppress_after_upstream",
    "occurrence": 1
  },
  "state": {
    "mode": "sqlite",
    "db": "{DATA_DIR}/.finance/finance.db",
    "table": "goals",
    "where": "name='CRASHLAB_KIST_ONE_INTENT'",
    "expect": 1,
    "record_fields": {
      "target_amount": 1000,
      "current_amount": 100,
      "status": "active"
    }
  },
  "evidence": {
    "screenshot_dir": "{DATA_DIR}/shots"
  },
  "control": {
    "journey": [
      {
        "action": "goto",
        "path": "/#goals"
      },
      {
        "action": "wait_for_selector",
        "selector": "#gAdd"
      },
      {
        "action": "fill",
        "selector": "#gName",
        "value": "CRASHLAB_KIST_TWO_INTENTS"
      },
      {
        "action": "fill",
        "selector": "#gTarget",
        "value": "1000"
      },
      {
        "action": "fill",
        "selector": "#gCurrent",
        "value": "100"
      },
      {
        "action": "fill",
        "selector": "#gMonthly",
        "value": "50"
      },
      {
        "action": "click",
        "selector": "#gAdd"
      },
      {
        "action": "wait_for_count",
        "selector": "#gList h3",
        "text": "CRASHLAB_KIST_TWO_INTENTS",
        "min": 1,
        "max": 1
      },
      {
        "action": "reload"
      },
      {
        "action": "wait_for_selector",
        "selector": "#gAdd"
      },
      {
        "action": "fill",
        "selector": "#gName",
        "value": "CRASHLAB_KIST_TWO_INTENTS"
      },
      {
        "action": "fill",
        "selector": "#gTarget",
        "value": "1000"
      },
      {
        "action": "fill",
        "selector": "#gCurrent",
        "value": "100"
      },
      {
        "action": "fill",
        "selector": "#gMonthly",
        "value": "50"
      },
      {
        "action": "click",
        "selector": "#gAdd"
      },
      {
        "action": "wait_for_count",
        "selector": "#gList h3",
        "text": "CRASHLAB_KIST_TWO_INTENTS",
        "min": 2
      },
      {
        "action": "screenshot",
        "as": "two-intents"
      }
    ],
    "state": {
      "mode": "sqlite",
      "db": "{DATA_DIR}/.finance/finance.db",
      "table": "goals",
      "where": "name='CRASHLAB_KIST_TWO_INTENTS'",
      "expect": 2,
      "record_fields": {
        "target_amount": 1000,
        "current_amount": 100,
        "status": "active"
      }
    }
  },
  "recovery": {
    "mode": "retry",
    "success_statuses": [
      201
    ],
    "response_id_path": "id",
    "record_id_field": "id"
  }
}

+def test_goal_add_is_idempotent_per_intent_key(client):
+    """A retried add (lost acknowledgement) recovers its goal; a deliberate
+    second add with a new intent key is still a second goal."""
+    before = len(client.get("/api/goals").get_json())
+    body = {"name": "Retried goal", "target_amount": 4242}
+    first = client.post("/api/goals", json=body, headers={"Idempotency-Key": "goal-intent-a"})
+    retry = client.post("/api/goals", json=body, headers={"Idempotency-Key": "goal-intent-a"})
+    assert first.status_code == 201
+    assert retry.status_code == 200
+    assert first.get_json()["id"] == retry.get_json()["id"]
+    names = [g["name"] for g in client.get("/api/goals").get_json()]
+    assert names.count("Retried goal") == 1
+    other = client.post("/api/goals", json=body, headers={"Idempotency-Key": "goal-intent-b"})
+    assert other.status_code == 201
+    assert other.get_json()["id"] != first.get_json()["id"]
+    goals = client.get("/api/goals").get_json()
+    assert [g["name"] for g in goals].count("Retried goal") == 2
+    assert len(goals) == before + 2
+
+

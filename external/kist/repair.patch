diff -ruN '--exclude=__pycache__' '--exclude=*.pyc' '--exclude=.finance' '--exclude=node_modules' '--exclude=.pytest_cache' '--exclude=.hypothesis' a/tests/test_goals_idempotency.py b/tests/test_goals_idempotency.py
--- a/tests/test_goals_idempotency.py	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/test_goals_idempotency.py	2026-11-06 21:57:31.391719741 +0000
@@ -0,0 +1,97 @@
+"""Goal create is idempotent per client intent key (lost-response retry)."""
+import sqlite3
+
+
+def _count(client):
+    return len(client.get("/api/goals").get_json())
+
+
+def _post(client, key=None, headers=None):
+    body = {"name": "Retry goal", "target_amount": 5000}
+    if key is not None:
+        body["client_request_id"] = key
+    return client.post("/api/goals", json=body, headers=headers or {})
+
+
+def _ids(client):
+    return {g["id"] for g in client.get("/api/goals").get_json()}
+
+
+def test_same_intent_key_creates_one_goal(client):
+    before = _count(client)
+    first = _post(client, key="intent-abc")
+    second = _post(client, key="intent-abc")
+    assert first.status_code == 201 and second.status_code == 201
+    assert first.get_json()["id"] == second.get_json()["id"]
+    assert _count(client) == before + 1
+    client.delete("/api/goals/" + first.get_json()["id"])
+
+
+def test_different_intent_keys_create_two_goals(client):
+    before = _count(client)
+    a = _post(client, key="intent-a")
+    b = _post(client, key="intent-b")
+    assert a.get_json()["id"] != b.get_json()["id"]
+    assert _count(client) == before + 2
+    for r in (a, b):
+        client.delete("/api/goals/" + r.get_json()["id"])
+
+
+def test_no_intent_key_keeps_create_always(client):
+    before = _count(client)
+    a = _post(client)
+    b = _post(client)
+    assert a.get_json()["id"] != b.get_json()["id"]
+    assert _count(client) == before + 2
+    for r in (a, b):
+        client.delete("/api/goals/" + r.get_json()["id"])
+
+
+def test_idempotency_key_header_also_dedupes(client):
+    before = _count(client)
+    a = _post(client, headers={"Idempotency-Key": "intent-header"})
+    b = _post(client, headers={"Idempotency-Key": "intent-header"})
+    assert a.get_json()["id"] == b.get_json()["id"]
+    assert _count(client) == before + 1
+    client.delete("/api/goals/" + a.get_json()["id"])
+
+
+def test_init_db_migrates_legacy_goals_table(tmp_path, monkeypatch):
+    import db
+
+    monkeypatch.setenv("FINANCE_PROJECT_DIR", str(tmp_path))
+    finance = tmp_path / ".finance"
+    finance.mkdir()
+    con = sqlite3.connect(finance / "finance.db")
+    con.execute("""create table goals (
+        id text primary key, name text not null, target_amount real not null,
+        current_amount real default 0, target_date text, currency text default 'EUR',
+        status text default 'active', created_at text not null, updated_at text not null)""")
+    con.execute("insert into goals values "
+                "('old', 'legacy', 10, 0, null, 'PLN', 'active', '2026-01-01', '2026-01-01')")
+    con.commit()
+    con.close()
+
+    db.init_db()
+    db.init_db()  # migration is idempotent
+
+    con = sqlite3.connect(finance / "finance.db")
+    cols = {r[1] for r in con.execute("pragma table_info(goals)")}
+    assert "client_request_id" in cols
+    indexes = {r[1] for r in con.execute("pragma index_list(goals)")}
+    assert "idx_goals_client_request_id" in indexes
+    # existing row survives
+    assert con.execute("select name from goals where id = 'old'").fetchone()[0] == "legacy"
+
+    # uniqueness holds at the database level too
+    con.execute("insert into goals (id, name, target_amount, created_at, updated_at, "
+                "client_request_id) values ('g1', 'a', 1, 'x', 'x', 'k')")
+    try:
+        con.execute("insert into goals (id, name, target_amount, created_at, updated_at, "
+                    "client_request_id) values ('g2', 'b', 1, 'x', 'x', 'k')")
+    except sqlite3.IntegrityError:
+        pass
+    else:
+        raise AssertionError("duplicate client_request_id was accepted")
+    finally:
+        con.close()

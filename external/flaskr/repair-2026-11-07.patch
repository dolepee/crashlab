diff --git a/examples/tutorial/tests/test_submission_retry.py b/examples/tutorial/tests/test_submission_retry.py
new file mode 100644
index 0000000..7815e2f
--- /dev/null
+++ b/examples/tutorial/tests/test_submission_retry.py
@@ -0,0 +1,83 @@
+"""Focused checks runnable without pytest via python -m unittest discover."""
+
+import re
+import unittest
+
+from flaskr import create_app
+from flaskr.db import get_db
+from flaskr.db import init_db
+
+
+class SubmissionRetryTest(unittest.TestCase):
+    def setUp(self):
+        self.app = create_app({"TESTING": True, "DATABASE": ":memory:"})
+        self.context = self.app.app_context()
+        self.context.push()
+        self.addCleanup(self.context.pop)
+        init_db()
+        self.client = self.app.test_client()
+        self.client.post(
+            "/auth/register", data={"username": "retry", "password": "test"}
+        )
+        self.client.post(
+            "/auth/login", data={"username": "retry", "password": "test"}
+        )
+
+    def form_key(self):
+        response = self.client.get("/create")
+        self.assertEqual(response.status_code, 200)
+        match = re.search(
+            rb'name="submission_key" value="([^"]+)"', response.data
+        )
+        assert match is not None, "Create form must include a submission key"
+        return match.group(1).decode()
+
+    def submit(self, key, title="Same title", body="Same body"):
+        return self.client.post(
+            "/create", data={"submission_key": key, "title": title, "body": body}
+        )
+
+    def count(self):
+        return get_db().execute("SELECT COUNT(*) FROM post").fetchone()[0]
+
+    def test_replay_is_one_post(self):
+        key = self.form_key()
+        self.assertEqual(self.submit(key).status_code, 302)
+        self.assertEqual(self.submit(key).status_code, 302)
+        self.assertEqual(self.count(), 1)
+
+    def test_deliberate_identical_posts(self):
+        first, second = self.form_key(), self.form_key()
+        self.assertNotEqual(first, second)
+        self.assertEqual(self.submit(first).status_code, 302)
+        self.assertEqual(self.submit(second).status_code, 302)
+        self.assertEqual(self.count(), 2)
+
+    def test_reused_key_changed_content_is_rejected(self):
+        key = self.form_key()
+        self.assertEqual(self.submit(key).status_code, 302)
+        self.assertEqual(self.submit(key, body="Changed").status_code, 409)
+        self.assertEqual(self.count(), 1)
+        post = get_db().execute("SELECT body FROM post").fetchone()
+        self.assertEqual(post["body"], "Same body")
+
+    def test_validation_retains_key(self):
+        key = self.form_key()
+        response = self.submit(key, title="")
+        self.assertIn(b"Title is required.", response.data)
+        self.assertIn(f'value="{key}"'.encode(), response.data)
+        self.assertEqual(self.count(), 0)
+        self.assertEqual(self.submit(key).status_code, 302)
+        self.assertEqual(self.count(), 1)
+
+    def test_legacy_keyless_posts_remain_supported(self):
+        for _ in range(2):
+            response = self.client.post(
+                "/create", data={"title": "Same title", "body": "Same body"}
+            )
+            self.assertEqual(response.status_code, 302)
+        self.assertEqual(self.count(), 2)
+
+
+if __name__ == "__main__":
+    unittest.main()

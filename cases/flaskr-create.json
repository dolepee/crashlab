{
  "id": "flaskr-create",
  "app": {
    "start": {
      "command": [
        "/bin/sh",
        "-c",
        "{PYTHON} -m flask --app flaskr init-db && exec {PYTHON} -m flask --app flaskr run --host 127.0.0.1 --port {PORT}"
      ],
      "python": "{PYTHON}",
      "cwd": "{APP_DIR}",
      "env": {},
      "base_url": "http://127.0.0.1:{PORT}",
      "health_path": "/",
      "ready_timeout": 30
    }
  },
  "journey": [
    {
      "action": "goto",
      "path": "/auth/register"
    },
    {
      "action": "wait_for_selector",
      "selector": "#username"
    },
    {
      "action": "fill",
      "selector": "#username",
      "value": "crashlab"
    },
    {
      "action": "fill",
      "selector": "#password",
      "value": "crashlab-password"
    },
    {
      "action": "click",
      "selector": "input[type=submit]"
    },
    {
      "action": "wait_for_url",
      "pattern": "**/auth/login"
    },
    {
      "action": "fill",
      "selector": "#username",
      "value": "crashlab"
    },
    {
      "action": "fill",
      "selector": "#password",
      "value": "crashlab-password"
    },
    {
      "action": "click",
      "selector": "input[type=submit]"
    },
    {
      "action": "wait_for_url",
      "pattern": "**/"
    },
    {
      "action": "goto",
      "path": "/create"
    },
    {
      "action": "wait_for_selector",
      "selector": "#title"
    },
    {
      "action": "fill",
      "selector": "#title",
      "value": "CRASHLAB_FLASKR_CREATED"
    },
    {
      "action": "fill",
      "selector": "#body",
      "value": "A valid transfer workflow."
    },
    {
      "action": "click",
      "selector": "input[type=submit]"
    },
    {
      "action": "wait_for_text",
      "text": "CRASHLAB_FLASKR_CREATED"
    },
    {
      "action": "screenshot",
      "as": "created"
    }
  ],
  "state": {
    "mode": "sqlite",
    "db": "{APP_DIR}/instance/flaskr.sqlite",
    "table": "post",
    "where": "title='CRASHLAB_FLASKR_CREATED'",
    "expect": 1
  },
  "evidence": {
    "screenshot_dir": "{DATA_DIR}/shots"
  },
  "setup_required": "Clone the Flask tutorial and install its requirements. Set app.start.cwd and app.start.python to that checkout and interpreter, update state.db, then remove setup_required."
}

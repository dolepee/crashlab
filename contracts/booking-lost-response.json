{
  "id": "booking-lost-response",
  "app": {
    "base_url": "http://127.0.0.1:8785",
    "reset_url": "/reset"
  },
  "journey": [
    {
      "action": "goto",
      "path": "/"
    },
    {
      "action": "click",
      "selector": "#book"
    },
    {
      "action": "wait_for_selector",
      "selector": "#retry"
    },
    {
      "action": "text",
      "selector": "#status",
      "as": "first_message"
    },
    {
      "action": "screenshot",
      "as": "failure"
    },
    {
      "action": "click",
      "selector": "#retry"
    },
    {
      "action": "wait_for_text",
      "text": "Booking confirmed"
    },
    {
      "action": "text",
      "selector": "#status",
      "as": "second_message"
    },
    {
      "action": "screenshot",
      "as": "after_retry"
    }
  ],
  "fault": {
    "route": "**/book",
    "mode": "suppress_after_upstream",
    "occurrence": 1
  },
  "state": {
    "mode": "sqlite",
    "db": "../data/bookings-{port}.db",
    "table": "bookings",
    "where": "intent_key <> ''",
    "expect": 1
  },
  "evidence": {
    "screenshot_dir": "evidence"
  },
  "control": {
    "journey": [
      {
        "action": "goto",
        "path": "/"
      },
      {
        "action": "click",
        "selector": "#book"
      },
      {
        "action": "wait_for_text",
        "text": "Booking confirmed"
      },
      {
        "action": "reload"
      },
      {
        "action": "click",
        "selector": "#book"
      },
      {
        "action": "wait_for_text",
        "text": "Booking confirmed"
      }
    ],
    "state": {
      "mode": "sqlite",
      "db": "../data/bookings-{port}.db",
      "table": "bookings",
      "where": "intent_key <> ''",
      "expect": 2
    }
  }
}
